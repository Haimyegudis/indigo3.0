<Window x:Class="IndiLogs_3._0.Views.ScheduleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:IndiLogs_3._0.Converters"
        xmlns:models="clr-namespace:IndiLogs_3._0.Models.Grep"
        Title="Schedule Editor"
        Width="700" Height="920"
        MaxHeight="{x:Static SystemParameters.PrimaryScreenHeight}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgDark}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- Shared label style -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,6,0,3"/>
        </Style>

        <!-- Shared textbox style -->
        <Style x:Key="EditorTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4,6,4"/>
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <!-- Small button style -->
        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="6,2,6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Section header style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Section border style -->
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Hint text style -->
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
        <StackPanel>

            <!-- ═══════════════════════════════════════════ -->
            <!-- SECTION 1: SCHEDULE DETAILS                -->
            <!-- ═══════════════════════════════════════════ -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Schedule Details" Style="{StaticResource SectionHeader}"/>

                    <TextBlock Text="Schedule Name" Style="{StaticResource SectionLabel}"/>
                    <TextBox Text="{Binding ScheduleName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorTextBox}"/>

                    <CheckBox Content="Enabled" Foreground="{DynamicResource TextPrimary}"
                              IsChecked="{Binding IsEnabled}" FontSize="12" Margin="0,6,0,0"/>

                    <Separator Margin="0,8,0,4" Background="{DynamicResource BorderColor}"/>

                    <TextBlock Text="Scan Mode" Style="{StaticResource SectionLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Search Only" Foreground="{DynamicResource TextPrimary}"
                                     IsChecked="{Binding ScanModeSearch}" FontSize="12" Margin="0,0,16,0"
                                     GroupName="ScanMode"/>
                        <RadioButton Content="Statistics Only" Foreground="{DynamicResource TextPrimary}"
                                     IsChecked="{Binding ScanModeStats}" FontSize="12" Margin="0,0,16,0"
                                     GroupName="ScanMode"/>
                        <RadioButton Content="Search + Statistics" Foreground="{DynamicResource TextPrimary}"
                                     IsChecked="{Binding ScanModeBoth}" FontSize="12"
                                     GroupName="ScanMode"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,3,0,0"
                               Text="Search Only = find matching log entries. Statistics Only = compute error histograms, load distribution, gaps, state analysis (no search query needed). Search + Statistics = both."/>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════ -->
            <!-- SECTION 2: WHEN TO RUN                     -->
            <!-- ═══════════════════════════════════════════ -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="When to Run" Style="{StaticResource SectionHeader}"/>

                    <TextBlock Text="Schedule Type" Style="{StaticResource SectionLabel}"/>
                    <ComboBox SelectedIndex="{Binding ScheduleTypeIndex}"
                              Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}"
                              BorderBrush="{DynamicResource BorderColor}" FontSize="12" Padding="4,3,4,3">
                        <ComboBoxItem Content="Once (specific date &amp; time)"/>
                        <ComboBoxItem Content="Daily"/>
                        <ComboBoxItem Content="Weekly"/>
                        <ComboBoxItem Content="Interval (repeat every N hours/days)"/>
                    </ComboBox>

                    <!-- Run Date (Once only) -->
                    <TextBlock Text="Run Date" Style="{StaticResource SectionLabel}"
                               Visibility="{Binding IsOnce, Converter={StaticResource BoolToVis}}"/>
                    <DatePicker SelectedDate="{Binding RunDate}" FontSize="12"
                                Visibility="{Binding IsOnce, Converter={StaticResource BoolToVis}}"/>

                    <!-- Run Time -->
                    <TextBlock Text="{Binding TimeLabelText}" Style="{StaticResource SectionLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding RunHour, UpdateSourceTrigger=PropertyChanged}" Width="50"
                                 TextAlignment="Center" Padding="4" FontSize="14"
                                 Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}"
                                 BorderBrush="{DynamicResource BorderColor}"/>
                        <TextBlock Text=":" Foreground="{DynamicResource TextPrimary}" FontSize="16"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,4,0"/>
                        <TextBox Text="{Binding RunMinute, UpdateSourceTrigger=PropertyChanged}" Width="50"
                                 TextAlignment="Center" Padding="4" FontSize="14"
                                 Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}"
                                 BorderBrush="{DynamicResource BorderColor}"/>
                        <TextBlock Text="(24-hour format)" Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Days of Week (Weekly only) -->
                    <TextBlock Text="Run on Days" Style="{StaticResource SectionLabel}"
                               Visibility="{Binding IsWeekly, Converter={StaticResource BoolToVis}}"/>
                    <WrapPanel Visibility="{Binding IsWeekly, Converter={StaticResource BoolToVis}}">
                        <CheckBox Content="Sun" IsChecked="{Binding DaySun}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,10,0" FontSize="12"/>
                        <CheckBox Content="Mon" IsChecked="{Binding DayMon}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,10,0" FontSize="12"/>
                        <CheckBox Content="Tue" IsChecked="{Binding DayTue}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,10,0" FontSize="12"/>
                        <CheckBox Content="Wed" IsChecked="{Binding DayWed}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,10,0" FontSize="12"/>
                        <CheckBox Content="Thu" IsChecked="{Binding DayThu}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,10,0" FontSize="12"/>
                        <CheckBox Content="Fri" IsChecked="{Binding DayFri}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,10,0" FontSize="12"/>
                        <CheckBox Content="Sat" IsChecked="{Binding DaySat}" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                    </WrapPanel>

                    <!-- Repeat Interval (Interval only) -->
                    <TextBlock Text="Repeat Every" Style="{StaticResource SectionLabel}"
                               Visibility="{Binding IsInterval, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsInterval, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding IntervalValue, UpdateSourceTrigger=PropertyChanged}"
                                 Width="60" Style="{StaticResource EditorTextBox}" HorizontalAlignment="Left"/>
                        <ComboBox SelectedIndex="{Binding IntervalUnitIndex}"
                                  Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}"
                                  BorderBrush="{DynamicResource BorderColor}" FontSize="12"
                                  Margin="6,0,0,0" Padding="4,3,4,3">
                            <ComboBoxItem Content="Minutes"/>
                            <ComboBoxItem Content="Hours"/>
                            <ComboBoxItem Content="Days"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════ -->
            <!-- SECTION 3: WHAT TO SEARCH                  -->
            <!-- ═══════════════════════════════════════════ -->
            <Border Style="{StaticResource SectionBorder}"
                    Visibility="{Binding NeedsSearch, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="What to Search" Style="{StaticResource SectionHeader}"/>

                    <!-- Mode toggle -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Content="Simple Search" Foreground="{DynamicResource TextPrimary}"
                                     IsChecked="{Binding IsSimpleMode}" FontSize="12" Margin="0,0,20,0"
                                     GroupName="SearchMode"/>
                        <RadioButton Content="Advanced Conditions" Foreground="{DynamicResource TextPrimary}"
                                     IsChecked="{Binding IsAdvancedMode}" FontSize="12"
                                     GroupName="SearchMode"/>
                    </StackPanel>

                    <!-- Simple Search Panel -->
                    <StackPanel Visibility="{Binding IsSimpleMode, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Search in:" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding SearchFieldValues}" SelectedItem="{Binding SimpleField}"
                                      Width="110" FontSize="11" Background="{DynamicResource BgCard}"
                                      Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}"/>
                        </StackPanel>
                        <TextBlock Text="Search text" Style="{StaticResource SectionLabel}"/>
                        <TextBox Text="{Binding SimpleSearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorTextBox}"/>
                        <CheckBox Content="Use Regular Expression" Foreground="{DynamicResource TextPrimary}"
                                  IsChecked="{Binding SimpleUseRegex}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Advanced Conditions Panel -->
                    <StackPanel Visibility="{Binding IsSimpleMode, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Combine conditions with:" Foreground="{DynamicResource TextSecondary}"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding ConditionOperatorValues}" SelectedItem="{Binding AdvancedOperator}"
                                      Width="70" FontSize="11" Background="{DynamicResource BgCard}"
                                      Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}"/>
                        </StackPanel>

                        <!-- Condition rows -->
                        <ItemsControl ItemsSource="{Binding Conditions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding SearchFieldValues}" SelectedItem="{Binding Field}"
                                                  FontSize="11" Margin="0,0,3,0"
                                                  Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}"
                                                  BorderBrush="{DynamicResource BorderColor}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding SearchOperatorValues}" SelectedItem="{Binding Operator}"
                                                  FontSize="11" Margin="0,0,3,0"
                                                  Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}"
                                                  BorderBrush="{DynamicResource BorderColor}"/>
                                        <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" Padding="4,2,4,2" Margin="0,0,3,0"
                                                 Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}"
                                                 BorderBrush="{DynamicResource BorderColor}"/>
                                        <CheckBox Grid.Column="3" Content="Excl" IsChecked="{Binding Negate}"
                                                  Foreground="{DynamicResource TextPrimary}"
                                                  VerticalAlignment="Center" Margin="0,0,3,0" FontSize="10"/>
                                        <Button Grid.Column="4" Content="X" Width="22" Padding="0,2,0,2"
                                                Background="{DynamicResource BgCard}" Foreground="{DynamicResource DangerColor}"
                                                BorderBrush="{DynamicResource BorderColor}" FontSize="11" Cursor="Hand"
                                                Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="+ Add Condition" Style="{StaticResource SmallBtn}" FontSize="11"
                                Padding="8,3,8,3" HorizontalAlignment="Left" Margin="0,4,0,0"
                                Command="{Binding AddConditionCommand}"/>
                    </StackPanel>

                    <!-- Separator + PLC/APP -->
                    <Separator Margin="0,8,0,4" Background="{DynamicResource BorderColor}"/>
                    <TextBlock Text="Log types to scan" Style="{StaticResource SectionLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="PLC logs" IsChecked="{Binding SearchPLC}" Foreground="{DynamicResource TextPrimary}"
                                  FontSize="12" Margin="0,0,20,0"/>
                        <CheckBox Content="APP logs" IsChecked="{Binding SearchAPP}" Foreground="{DynamicResource TextPrimary}"
                                  FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════ -->
            <!-- SECTION 4: WHERE TO SEARCH                 -->
            <!-- ═══════════════════════════════════════════ -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Where to Search" Style="{StaticResource SectionHeader}"/>

                    <TextBlock Text="No locations configured." FontSize="11" FontStyle="Italic"
                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                               Visibility="{Binding HasLocations, Converter={StaticResource InverseBoolToVis}}"/>

                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasLocations, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding LocationItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayText}" IsChecked="{Binding IsChecked}"
                                              Foreground="{DynamicResource TextPrimary}" FontSize="11" Margin="0,0,0,3"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="+ Add Location" Style="{StaticResource SmallBtn}" Margin="0,0,6,0"
                                Command="{Binding AddLocationCommand}"/>
                        <Button Content="Select All" Style="{StaticResource SmallBtn}" Margin="0,0,6,0"
                                Command="{Binding SelectAllLocationsCommand}"/>
                        <Button Content="Select None" Style="{StaticResource SmallBtn}"
                                Command="{Binding SelectNoLocationsCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════ -->
            <!-- SECTION 5: TIME FILTERS                    -->
            <!-- ═══════════════════════════════════════════ -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Time Filters (optional)" Style="{StaticResource SectionHeader}"/>

                    <!-- File modified date filter -->
                    <TextBlock Text="File modified date (skip files outside this range)" Style="{StaticResource SectionLabel}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                        <RadioButton Content="Custom range" Foreground="{DynamicResource TextPrimary}" FontSize="11"
                                     IsChecked="{Binding FileFilterCustom}" Margin="0,0,14,0" GroupName="FileFilter"/>
                        <RadioButton Content="Last 24 hours" Foreground="{DynamicResource TextPrimary}" FontSize="11"
                                     IsChecked="{Binding FileFilter24h}" Margin="0,0,14,0" GroupName="FileFilter"/>
                        <RadioButton Content="Last week" Foreground="{DynamicResource TextPrimary}" FontSize="11"
                                     IsChecked="{Binding FileFilterWeek}" GroupName="FileFilter"/>
                    </StackPanel>
                    <Grid Visibility="{Binding FileFilterIsCustom, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="From:" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                        <DatePicker Grid.Column="1" SelectedDate="{Binding FileFromDate}" FontSize="11"/>
                        <TextBlock Grid.Column="2" Text="To:" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <DatePicker Grid.Column="3" SelectedDate="{Binding FileToDate}" FontSize="11"/>
                    </Grid>

                    <!-- Result timestamp filter -->
                    <TextBlock Text="Result timestamp filter" Style="{StaticResource SectionLabel}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                        <RadioButton Content="Custom range" Foreground="{DynamicResource TextPrimary}" FontSize="11"
                                     IsChecked="{Binding ResultFilterCustom}" Margin="0,0,14,0" GroupName="ResultFilter"/>
                        <RadioButton Content="Last 24 hours" Foreground="{DynamicResource TextPrimary}" FontSize="11"
                                     IsChecked="{Binding ResultFilter24h}" Margin="0,0,14,0" GroupName="ResultFilter"/>
                        <RadioButton Content="Last week" Foreground="{DynamicResource TextPrimary}" FontSize="11"
                                     IsChecked="{Binding ResultFilterWeek}" GroupName="ResultFilter"/>
                    </StackPanel>
                    <Grid Visibility="{Binding ResultFilterIsCustom, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="From:" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                        <DatePicker Grid.Column="1" SelectedDate="{Binding ResultFromDate}" FontSize="11"/>
                        <TextBlock Grid.Column="2" Text="To:" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <DatePicker Grid.Column="3" SelectedDate="{Binding ResultToDate}" FontSize="11"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════ -->
            <!-- SECTION 6: OUTPUT                          -->
            <!-- ═══════════════════════════════════════════ -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Output" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="Output Directory" Style="{StaticResource SectionLabel}"/>
                    <DockPanel>
                        <Button Content="Browse..." Width="70" Padding="4,3,4,3" DockPanel.Dock="Right"
                                Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}"
                                BorderBrush="{DynamicResource BorderColor}" FontSize="11" Margin="6,0,0,0" Cursor="Hand"
                                Command="{Binding BrowseOutputCommand}"/>
                        <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorTextBox}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════ -->
            <!-- SECTION 7: EMAIL NOTIFICATIONS             -->
            <!-- ═══════════════════════════════════════════ -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Email Notifications" Style="{StaticResource SectionHeader}"/>

                    <CheckBox Content="Enable email notifications" Foreground="{DynamicResource TextPrimary}"
                              IsChecked="{Binding EmailEnabled}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <StackPanel Visibility="{Binding EmailEnabled, Converter={StaticResource BoolToVis}}">

                        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6"
                                   Text="Emails are sent via your local Outlook installation (no SMTP configuration needed)."/>
                        <TextBlock Text="Recipients" Style="{StaticResource SectionLabel}"/>

                        <ItemsControl ItemsSource="{Binding Recipients}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimary}"
                                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="X" Width="20" Padding="0"
                                                Background="{DynamicResource BgCard}" Foreground="{DynamicResource DangerColor}"
                                                BorderBrush="{DynamicResource BorderColor}" FontSize="10" Cursor="Hand"
                                                Command="{Binding DataContext.RemoveRecipientCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBox Text="{Binding NewRecipient, UpdateSourceTrigger=PropertyChanged}" Width="250" Style="{StaticResource EditorTextBox}"/>
                            <Button Content="+" Width="28" Padding="0,2,0,2" Margin="4,0,0,0"
                                    Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}"
                                    BorderBrush="{DynamicResource BorderColor}" FontSize="12" Cursor="Hand"
                                    Command="{Binding AddRecipientCommand}"/>
                        </StackPanel>

                        <!-- Test Email -->
                        <Button Content="Send Test Email" Style="{StaticResource SmallBtn}" FontSize="11"
                                Padding="8,3,8,3" HorizontalAlignment="Left" Margin="0,6,0,4"
                                Command="{Binding SendTestEmailCommand}"/>
                        <TextBlock Text="{Binding TestEmailStatus}" Style="{StaticResource HintText}"/>

                        <!-- Timing -->
                        <Separator Margin="0,8,0,4" Background="{DynamicResource BorderColor}"/>
                        <TextBlock Text="Email Timing" Style="{StaticResource SectionLabel}"/>
                        <RadioButton Content="Send immediately after scan completes" Foreground="{DynamicResource TextPrimary}"
                                     FontSize="11" IsChecked="{Binding TimingImmediate}" Margin="0,0,0,4" GroupName="EmailTiming"/>
                        <RadioButton Content="Send at specific time:" Foreground="{DynamicResource TextPrimary}"
                                     FontSize="11" IsChecked="{Binding TimingDeferred}" GroupName="EmailTiming"/>

                        <StackPanel Orientation="Horizontal" Margin="20,4,0,0"
                                    Visibility="{Binding TimingIsDeferred, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding EmailHour, UpdateSourceTrigger=PropertyChanged}" Width="40"
                                     TextAlignment="Center" Padding="4" FontSize="12"
                                     Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}"
                                     BorderBrush="{DynamicResource BorderColor}"/>
                            <TextBlock Text=":" Foreground="{DynamicResource TextPrimary}" FontSize="14"
                                       VerticalAlignment="Center" Margin="3,0,3,0"/>
                            <TextBox Text="{Binding EmailMinute, UpdateSourceTrigger=PropertyChanged}" Width="40"
                                     TextAlignment="Center" Padding="4" FontSize="12"
                                     Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}"
                                     BorderBrush="{DynamicResource BorderColor}"/>
                        </StackPanel>

                        <!-- Custom Subject -->
                        <TextBlock Text="Custom Subject (optional)" Style="{StaticResource SectionLabel}"/>
                        <TextBox Text="{Binding CustomSubject, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorTextBox}"/>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Leave empty for auto-generated: &quot;[IndiLogs] Name - N matches, N logs&quot;"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════ -->
            <!-- SAVE / CANCEL BUTTONS                      -->
            <!-- ═══════════════════════════════════════════ -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Save" Width="90" IsDefault="True" Padding="6,8,6,8"
                        Background="{DynamicResource PrimaryColor}" Foreground="White"
                        FontWeight="Bold" FontSize="12" Margin="0,0,8,0" Cursor="Hand"
                        Command="{Binding SaveCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                <Button Content="Cancel" Width="90" IsCancel="True" Padding="6,8,6,8"
                        Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}" FontSize="12" Cursor="Hand"
                        Command="{Binding CancelCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
