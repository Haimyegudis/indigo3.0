<Window x:Class="IndiLogs_3._0.Views.TabSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Components to Load" Height="720" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <Window.Resources>
        <!-- ═══ Toggle Switch CheckBox ═══ -->
        <Style TargetType="CheckBox" x:Key="ToggleSwitch">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{DynamicResource UIFontFamily}"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                            <Grid Grid.Column="1" Width="40" Height="22" Margin="10,0,0,0">
                                <Border x:Name="Track" CornerRadius="11" Background="#3A3F4B"/>
                                <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9"
                                        HorizontalAlignment="Left" Margin="2,0,0,0"
                                        Background="White"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#3B82F6"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Section Header (accent bar + label) ═══ -->
        <Style TargetType="StackPanel" x:Key="SectionHeader">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>

        <!-- ═══ Time segment text ═══ -->
        <Style TargetType="TextBlock" x:Key="TimeSegmentText">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══ Colon separator ═══ -->
        <Style TargetType="TextBlock" x:Key="TimeSeparator">
            <Setter Property="Text" Value=":"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="1,0"/>
        </Style>

        <!-- ═══ Primary button (Load) ═══ -->
        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="20,9"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Ghost button (Cancel) ═══ -->
        <Style TargetType="Button" x:Key="GhostBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent"
                                CornerRadius="8" Padding="20,9"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderColor}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#15FFFFFF"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource TextSecondary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Text link button (Select All / Deselect All) ═══ -->
        <Style TargetType="Button" x:Key="LinkBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="10,5">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}" FontSize="12"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#10FFFFFF"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ═══ Root container with drop shadow ═══ -->
    <Border Margin="16" CornerRadius="12"
            Background="{DynamicResource BgDark}"
            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.6" Color="#000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Title bar -->
                <RowDefinition Height="Auto"/>  <!-- Time range -->
                <RowDefinition Height="*"/>     <!-- Components -->
                <RowDefinition Height="Auto"/>  <!-- Footer buttons -->
            </Grid.RowDefinitions>

            <!-- ═══ TITLE BAR ═══ -->
            <Grid Grid.Row="0" Margin="20,14,8,0"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Select Components to Load"
                               FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               FontFamily="{DynamicResource UIFontFamily}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border CornerRadius="4" Padding="7,2"
                                Background="#203B82F6">
                            <TextBlock x:Name="ConfigTypeText" Text="S4-5"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#3B82F6"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Close button -->
                <Button Grid.Column="1" Click="CloseButton_Click"
                        VerticalAlignment="Top" Width="30" Height="30">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseBg" Background="Transparent"
                                    CornerRadius="6" Width="30" Height="30">
                                <TextBlock Text="&#x2715;" FontSize="13"
                                           Foreground="{DynamicResource TextSecondary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseBg" Property="Background" Value="#30EF4444"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ═══ TIME RANGE CARD ═══ -->
            <Border Grid.Row="1" x:Name="TimeRangeSection" Visibility="Collapsed"
                    Background="{DynamicResource BgPanel}"
                    BorderBrush="#303B82F6" BorderThickness="1"
                    CornerRadius="10" Padding="16,12" Margin="16,14,16,0">
                <StackPanel>
                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="3" Height="14" CornerRadius="1.5"
                                Background="#3B82F6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="TIME RANGE" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>

                    <!-- Period and duration -->
                    <TextBlock x:Name="TxtLogPeriod"
                               Foreground="{DynamicResource TextPrimary}" FontSize="13"
                               FontFamily="{DynamicResource UIFontFamily}"/>
                    <TextBlock x:Name="TxtDuration"
                               Foreground="{DynamicResource TextSecondary}" FontSize="12"
                               Margin="0,2,0,8"/>

                    <!-- Toggle: Filter by time range -->
                    <CheckBox x:Name="ChkTimeFilter" Content="Filter by time range"
                              Style="{StaticResource ToggleSwitch}"
                              Checked="ChkTimeFilter_Changed" Unchecked="ChkTimeFilter_Changed"/>

                    <!-- Scrollable time segments -->
                    <StackPanel x:Name="TimeSegmentsPanel" Orientation="Horizontal"
                                Margin="0,8,0,2" Opacity="0.35" IsHitTestVisible="False"
                                HorizontalAlignment="Center">
                        <!-- FROM -->
                        <Border Tag="FH" MouseWheel="TimeSegment_MouseWheel"
                                MouseEnter="TimeSegment_MouseEnter" MouseLeave="TimeSegment_MouseLeave"
                                Background="{DynamicResource BgCard}" CornerRadius="6"
                                Padding="6,4" Cursor="Hand" BorderThickness="1.5"
                                BorderBrush="Transparent" ToolTip="Scroll to adjust hours">
                            <TextBlock x:Name="TxtFromHour" Text="00" Style="{StaticResource TimeSegmentText}"/>
                        </Border>
                        <TextBlock Style="{StaticResource TimeSeparator}"/>
                        <Border Tag="FM" MouseWheel="TimeSegment_MouseWheel"
                                MouseEnter="TimeSegment_MouseEnter" MouseLeave="TimeSegment_MouseLeave"
                                Background="{DynamicResource BgCard}" CornerRadius="6"
                                Padding="6,4" Cursor="Hand" BorderThickness="1.5"
                                BorderBrush="Transparent" ToolTip="Scroll to adjust minutes">
                            <TextBlock x:Name="TxtFromMin" Text="00" Style="{StaticResource TimeSegmentText}"/>
                        </Border>
                        <TextBlock Style="{StaticResource TimeSeparator}"/>
                        <Border Tag="FS" MouseWheel="TimeSegment_MouseWheel"
                                MouseEnter="TimeSegment_MouseEnter" MouseLeave="TimeSegment_MouseLeave"
                                Background="{DynamicResource BgCard}" CornerRadius="6"
                                Padding="6,4" Cursor="Hand" BorderThickness="1.5"
                                BorderBrush="Transparent" ToolTip="Scroll to adjust seconds">
                            <TextBlock x:Name="TxtFromSec" Text="00" Style="{StaticResource TimeSegmentText}"/>
                        </Border>

                        <!-- Arrow -->
                        <TextBlock Text="&#x2192;" FontSize="16"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="14,0"
                                   FontFamily="{DynamicResource UIFontFamily}"/>

                        <!-- TO -->
                        <Border Tag="TH" MouseWheel="TimeSegment_MouseWheel"
                                MouseEnter="TimeSegment_MouseEnter" MouseLeave="TimeSegment_MouseLeave"
                                Background="{DynamicResource BgCard}" CornerRadius="6"
                                Padding="6,4" Cursor="Hand" BorderThickness="1.5"
                                BorderBrush="Transparent" ToolTip="Scroll to adjust hours">
                            <TextBlock x:Name="TxtToHour" Text="00" Style="{StaticResource TimeSegmentText}"/>
                        </Border>
                        <TextBlock Style="{StaticResource TimeSeparator}"/>
                        <Border Tag="TM" MouseWheel="TimeSegment_MouseWheel"
                                MouseEnter="TimeSegment_MouseEnter" MouseLeave="TimeSegment_MouseLeave"
                                Background="{DynamicResource BgCard}" CornerRadius="6"
                                Padding="6,4" Cursor="Hand" BorderThickness="1.5"
                                BorderBrush="Transparent" ToolTip="Scroll to adjust minutes">
                            <TextBlock x:Name="TxtToMin" Text="00" Style="{StaticResource TimeSegmentText}"/>
                        </Border>
                        <TextBlock Style="{StaticResource TimeSeparator}"/>
                        <Border Tag="TS" MouseWheel="TimeSegment_MouseWheel"
                                MouseEnter="TimeSegment_MouseEnter" MouseLeave="TimeSegment_MouseLeave"
                                Background="{DynamicResource BgCard}" CornerRadius="6"
                                Padding="6,4" Cursor="Hand" BorderThickness="1.5"
                                BorderBrush="Transparent" ToolTip="Scroll to adjust seconds">
                            <TextBlock x:Name="TxtToSec" Text="00" Style="{StaticResource TimeSegmentText}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ COMPONENTS LIST ═══ -->
            <Border Grid.Row="2" Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    CornerRadius="10" Padding="16,4,16,10" Margin="16,14,16,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CheckboxPanel">

                        <!-- LOG DATA -->
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <Border Width="3" Height="14" CornerRadius="1.5"
                                    Background="#3B82F6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="LOG DATA" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkPlc" Content="PLC Logs" IsChecked="True" Style="{StaticResource ToggleSwitch}"/>
                        <CheckBox x:Name="ChkApp" Content="APP Logs" IsChecked="True" Style="{StaticResource ToggleSwitch}"/>
                        <CheckBox x:Name="ChkEvents" Content="Events (CSV)" IsChecked="True" Style="{StaticResource ToggleSwitch}"/>
                        <CheckBox x:Name="ChkScreenshots" Content="Screenshots" IsChecked="True" Style="{StaticResource ToggleSwitch}"/>
                        <CheckBox x:Name="ChkManagerThread" Content="Manager Thread (S6)" IsChecked="True" Style="{StaticResource ToggleSwitch}"/>

                        <!-- CONFIG & FILES -->
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <Border Width="3" Height="14" CornerRadius="1.5"
                                    Background="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="CONFIG &amp; FILES" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkConfiguration" Content="Configuration" IsChecked="True" Style="{StaticResource ToggleSwitch}"/>
                        <CheckBox x:Name="ChkTerminalLogs" Content="Terminal Logs" IsChecked="True" Style="{StaticResource ToggleSwitch}"/>
                        <CheckBox x:Name="ChkLrs" Content="LRS Files" IsChecked="True" Style="{StaticResource ToggleSwitch}"/>
                        <CheckBox x:Name="ChkSetupInfo" Content="Setup Info" IsChecked="True" Style="{StaticResource ToggleSwitch}"/>
                        <CheckBox x:Name="ChkSystab" Content="Systab" IsChecked="True" Style="{StaticResource ToggleSwitch}"/>
                        <CheckBox x:Name="ChkGlobals" Content="Globals" IsChecked="True" Style="{StaticResource ToggleSwitch}"/>

                        <!-- TOOLS -->
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <Border Width="3" Height="14" CornerRadius="1.5"
                                    Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="TOOLS" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkCharts" Content="Charts" IsChecked="True" Style="{StaticResource ToggleSwitch}"/>
                        <CheckBox x:Name="ChkCpr" Content="CPR" IsChecked="True" Style="{StaticResource ToggleSwitch}"/>
                        <CheckBox x:Name="ChkStepRecorder" Content="Step Recorder" IsChecked="True" Style="{StaticResource ToggleSwitch}"/>
                        <CheckBox x:Name="ChkDifferentLogs" Content="Different Logs" IsChecked="True" Style="{StaticResource ToggleSwitch}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ═══ FOOTER BUTTONS ═══ -->
            <Grid Grid.Row="3" Margin="16,12,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Select / Deselect -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Select All" Style="{StaticResource LinkBtn}" Click="SelectAll_Click"/>
                    <Button Content="Deselect All" Style="{StaticResource LinkBtn}" Click="DeselectAll_Click"/>
                </StackPanel>

                <!-- Cancel / Load -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Cancel" Style="{StaticResource GhostBtn}"
                            Click="CancelButton_Click" Margin="0,0,8,0"/>
                    <Button Content="Load" Style="{StaticResource PrimaryBtn}"
                            Click="OkButton_Click" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
