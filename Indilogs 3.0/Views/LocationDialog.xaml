<Window x:Class="IndiLogs_3._0.Views.LocationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Location"
        Width="480" Height="340"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDark}">
    <StackPanel Margin="20">
        <!-- Name field -->
        <TextBlock Text="Friendly Name"
                   Foreground="{DynamicResource TextPrimary}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4"/>
        <TextBlock Text="A short label for this location (e.g. &quot;Simulator 1&quot;)"
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="11"
                   Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox"
                 Padding="6,4"
                 Background="{DynamicResource BgCard}"
                 Foreground="{DynamicResource TextPrimary}"
                 BorderBrush="{DynamicResource BorderColor}"
                 Margin="0,0,0,12"/>

        <!-- Address field -->
        <TextBlock Text="IP Address / Hostname"
                   Foreground="{DynamicResource TextPrimary}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4"/>
        <TextBlock Text="Machine IP or hostname (e.g. &quot;192.168.1.10&quot; or &quot;localhost&quot;)"
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="11"
                   Margin="0,0,0,4"/>
        <TextBox x:Name="AddressBox"
                 Padding="6,4"
                 Background="{DynamicResource BgCard}"
                 Foreground="{DynamicResource TextPrimary}"
                 BorderBrush="{DynamicResource BorderColor}"
                 Margin="0,0,0,12"/>

        <!-- Path field with Browse -->
        <TextBlock Text="Log Folder Path"
                   Foreground="{DynamicResource TextPrimary}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4"/>
        <TextBlock Text="Folder containing log files (local, mapped drive, or UNC path)"
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="11"
                   Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,16">
            <Button Content="Browse..."
                    DockPanel.Dock="Right"
                    Width="75"
                    Padding="6,4"
                    Background="{DynamicResource BgCard}"
                    Foreground="{DynamicResource TextPrimary}"
                    BorderBrush="{DynamicResource BorderColor}"
                    Margin="6,0,0,0"
                    Click="BrowseButton_Click"/>
            <TextBox x:Name="PathBox"
                     Padding="6,4"
                     Background="{DynamicResource BgCard}"
                     Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource BorderColor}"/>
        </DockPanel>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK"
                    Width="80"
                    Padding="6"
                    Background="{DynamicResource PrimaryColor}"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="OkButton_Click"/>
            <Button Content="Cancel"
                    Width="80"
                    Padding="6"
                    Background="{DynamicResource BgCard}"
                    Foreground="{DynamicResource TextPrimary}"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
