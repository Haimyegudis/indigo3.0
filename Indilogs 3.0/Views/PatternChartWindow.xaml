<Window x:Class="IndiLogs_3._0.Views.PatternChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Chart from Pattern" Height="420" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDark}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Original message (read-only) -->
        <TextBlock Grid.Row="0" Text="Original Message:" FontWeight="Bold" FontSize="13" Margin="0,0,0,4" Foreground="{DynamicResource TextPrimary}"/>
        <TextBox Grid.Row="1" x:Name="MessageTextBox" IsReadOnly="True" TextWrapping="Wrap" Height="60"
                 VerticalScrollBarVisibility="Auto" Padding="6" FontSize="12" Margin="0,0,0,12"
                 Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextSecondary}"
                 BorderBrush="{DynamicResource BorderColor}"/>

        <!-- Regex pattern -->
        <TextBlock Grid.Row="2" Text="Extraction Pattern (regex with capture group):" FontWeight="Bold" FontSize="13" Margin="0,0,0,4" Foreground="{DynamicResource TextPrimary}"/>
        <DockPanel Grid.Row="3" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Auto-Detect" Click="AutoDetect_Click"
                    Style="{DynamicResource ModernBtn}" Background="{DynamicResource AccentColor}"
                    Foreground="White" FontSize="12" Margin="8,0,0,0" Padding="12,4"/>
            <TextBox x:Name="PatternTextBox" TextWrapping="Wrap" Padding="6" FontSize="12" FontFamily="Consolas"
                     Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource BorderColor}" CaretBrush="{DynamicResource TextPrimary}"
                     TextChanged="PatternTextBox_TextChanged"/>
        </DockPanel>

        <!-- Chart name -->
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Chart Name:" FontWeight="Bold" FontSize="13" Margin="0,0,0,4" Foreground="{DynamicResource TextPrimary}"/>
                <TextBox x:Name="ChartNameTextBox" Padding="6" FontSize="12"
                         Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource BorderColor}" CaretBrush="{DynamicResource TextPrimary}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Search In:" FontWeight="Bold" FontSize="13" Margin="0,0,0,4" Foreground="{DynamicResource TextPrimary}"/>
                <ComboBox x:Name="SearchFieldCombo" Width="140" FontSize="12" SelectedIndex="0"
                          Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}">
                    <ComboBoxItem Content="Message"/>
                    <ComboBoxItem Content="Logger"/>
                    <ComboBoxItem Content="ThreadName"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Include states -->
        <CheckBox Grid.Row="5" x:Name="IncludeStatesCheckBox" Content="Include Machine State (Gantt track)"
                  IsChecked="True" FontSize="13" Margin="0,0,0,12"
                  Foreground="{DynamicResource TextPrimary}"/>

        <!-- Preview -->
        <TextBlock Grid.Row="6" x:Name="PreviewLabel" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource TextSecondary}"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Create Chart" Click="Create_Click" Style="{DynamicResource ModernBtn}"
                    Background="{DynamicResource SuccessColor}" Foreground="White" FontSize="13" IsDefault="True"/>
            <Button Content="Cancel" Click="Cancel_Click" Style="{DynamicResource ModernBtn}"
                    Background="{DynamicResource DangerColor}" Foreground="White" FontSize="13" IsCancel="True" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
