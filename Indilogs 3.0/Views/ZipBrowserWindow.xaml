<Window x:Class="IndiLogs_3._0.Views.ZipBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browse ZIP Contents" Height="550" Width="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDark}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Select a file from the ZIP archive"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,6"/>
            <TextBlock x:Name="ZipNameLabel"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="12" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Search box -->
        <Border Grid.Row="1" Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                CornerRadius="4" Margin="0,0,0,8" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="2,0,6,0" Opacity="0.6"/>
                <TextBox x:Name="SearchBox" Grid.Column="1"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextPrimary}"
                         FontSize="12" VerticalAlignment="Center"
                         TextChanged="SearchBox_TextChanged"/>
            </Grid>
        </Border>

        <!-- File list -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1" Background="{DynamicResource BgPanel}"
                CornerRadius="4">
            <ListBox x:Name="FileList"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectionMode="Single"
                     MouseDoubleClick="FileList_MouseDoubleClick"
                     FontFamily="{DynamicResource ContentFontFamily}"
                     FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#15FFFFFF"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgCard}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- Footer buttons -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="CountLabel" Grid.Column="0"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="11" VerticalAlignment="Center"/>

            <Button x:Name="OpenButton" Grid.Column="2"
                    Content="Open" Width="100" Height="30"
                    FontWeight="SemiBold" Cursor="Hand"
                    Background="{DynamicResource PrimaryColor}"
                    Foreground="White" Margin="0,0,8,0"
                    Click="OpenButton_Click" IsDefault="True"/>

            <Button x:Name="BrowseExternalButton" Grid.Column="3"
                    Content="Browse Files..." Width="110" Height="30"
                    FontWeight="Normal" Cursor="Hand"
                    Background="{DynamicResource BgCard}"
                    Foreground="{DynamicResource TextPrimary}"
                    Click="BrowseExternalButton_Click" IsCancel="True"
                    ToolTip="Open a file from disk instead"/>
        </Grid>
    </Grid>
</Window>
