<Window x:Class="IndiLogs_3._0.Views.GlobalGrepWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Global Log Search" Height="750" Width="1300"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgDark}">

    <Window.Resources>
        <!-- Section header style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UIFontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <!-- Section description style -->
        <Style x:Key="SectionDesc" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UIFontFamily}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <!-- Field label style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UIFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <!-- Btn -->
        <Style x:Key="Btn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="{DynamicResource UIFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        <!-- Primary action button -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18,8"/>
        </Style>
        <!-- Danger button -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
        </Style>
        <!-- Section card -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================================ -->
        <!-- LEFT PANEL: Search Configuration                                 -->
        <!-- ================================================================ -->
        <DockPanel Grid.Column="0">

            <!-- Window title + Help button -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Search Configuration" FontFamily="{DynamicResource UIFontFamily}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="? Help" Style="{StaticResource Btn}" Click="HelpButton_Click" ToolTip="How to use Global Log Search"/>
            </Grid>

            <!-- Scrollable config sections -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- ─── SECTION 1: SEARCH LOCATIONS ─── -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="1. Search Locations" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Style="{StaticResource SectionDesc}"
                                       Text="Add machines or simulators to search by IP address or network path. Each location points to a folder containing log files."/>

                            <!-- Location list -->
                            <ListBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}"
                                     Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                     Foreground="{DynamicResource TextPrimary}" MinHeight="60" MaxHeight="160" Margin="0,0,0,8">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsActive}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                      ToolTip="Include this location in search"/>
                                            <Ellipse Grid.Column="1" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     ToolTip="{Binding ConnectionStatus}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="Gray"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ConnectionStatus}" Value="Connected">
                                                                <Setter Property="Fill" Value="{DynamicResource SuccessColor}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ConnectionStatus}" Value="Disconnected">
                                                                <Setter Property="Fill" Value="{DynamicResource DangerColor}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ConnectionStatus}" Value="Testing">
                                                                <Setter Property="Fill" Value="{DynamicResource WarningColor}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                                                <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="10">
                                                    <Run Text="{Binding Address, Mode=OneWay}"/>
                                                    <Run Text=" — "/>
                                                    <Run Text="{Binding BasePath, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Location action buttons -->
                            <WrapPanel>
                                <Button Content="+ Add Location" Style="{StaticResource Btn}" Command="{Binding AddLocationCommand}"
                                        ToolTip="Add a new machine or simulator by IP address"/>
                                <Button Content="Edit" Style="{StaticResource Btn}" Command="{Binding EditLocationCommand}"
                                        ToolTip="Edit the selected location"/>
                                <Button Content="Test Connection" Style="{StaticResource Btn}" Command="{Binding TestLocationCommand}"
                                        ToolTip="Ping the selected machine and verify the path exists"/>
                                <Button Content="Remove" Style="{StaticResource DangerBtn}" Command="{Binding RemoveLocationCommand}"
                                        ToolTip="Remove the selected location"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- ─── SECTION 2: SEARCH QUERY ─── -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="2. Search Query" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Style="{StaticResource SectionDesc}"
                                       Text="Type a text to search for across all log files. Supports AND, OR, NOT operators and quoted phrases."/>

                            <TextBlock Text="Search in field:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding SelectedQuickSearchField}"
                                      Margin="0,0,0,8" FontSize="12"
                                      ToolTip="Choose which log field to search in. 'Any' searches all fields."/>

                            <TextBlock Text="Search text:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource ContentFontFamily}" FontSize="13" Padding="6,4" Margin="0,0,0,8">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>

                            <CheckBox Content="Use Regular Expression (regex pattern matching)"
                                      IsChecked="{Binding UseRegex}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"
                                      ToolTip="Enable regex syntax like .*error.* or \d{3}"/>

                            <TextBlock Text="Log types to scan:" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <CheckBox Content="PLC logs" IsChecked="{Binding SearchPLC}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,20,0"
                                          ToolTip="Search in PLC/main log files"/>
                                <CheckBox Content="APP logs" IsChecked="{Binding SearchAPP}" Foreground="{DynamicResource TextPrimary}"
                                          ToolTip="Search in APP/dev log files"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ─── SECTION 3: ADVANCED CONDITIONS ─── -->
                    <Border Style="{StaticResource SectionCard}">
                        <Expander IsExpanded="{Binding HasConditions}" Foreground="{DynamicResource TextPrimary}">
                            <Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="3. Advanced Conditions (optional)" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Style="{StaticResource SectionDesc}" Margin="0"
                                               Text="Search specific fields with logical operators. Click to expand."/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <!-- Group operator -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Combine condition groups with:" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding GroupOperatorOptions}" SelectedItem="{Binding SelectedGroupOperator}" Width="65"
                                              ToolTip="AND = all groups must match. OR = any group can match."/>
                                </StackPanel>

                                <!-- Condition groups -->
                                <ItemsControl ItemsSource="{Binding ConditionGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                                    CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <!-- Group header -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="Match:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11"/>
                                                        <ComboBox ItemsSource="{Binding DataContext.ConditionOperatorOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  SelectedItem="{Binding Operator}" Width="60" FontSize="11"
                                                                  ToolTip="AND = all conditions must match. OR = any condition. NOR = none must match."/>
                                                        <Button Content="+ Add Condition" Style="{StaticResource Btn}" FontSize="11" Padding="6,3"
                                                                Command="{Binding DataContext.AddConditionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" Margin="8,0,0,0"/>
                                                        <Button Content="Remove Group" Style="{StaticResource DangerBtn}" FontSize="11" Padding="6,3"
                                                                Command="{Binding DataContext.RemoveGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>

                                                    <!-- Conditions -->
                                                    <ItemsControl ItemsSource="{Binding Conditions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="100"/>
                                                                        <ColumnDefinition Width="90"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <ComboBox Grid.Column="0" ItemsSource="{Binding DataContext.FieldOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              SelectedItem="{Binding Field}" Margin="0,0,3,0" FontSize="11"
                                                                              ToolTip="Which log field to search in"/>
                                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.OperatorOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              SelectedItem="{Binding Operator}" Margin="0,0,3,0" FontSize="11"
                                                                              ToolTip="How to match the value"/>
                                                                    <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                             Margin="0,0,3,0" FontSize="11" Padding="4,2"
                                                                             ToolTip="The value to search for"/>
                                                                    <CheckBox Grid.Column="3" Content="Exclude" IsChecked="{Binding Negate}" VerticalAlignment="Center"
                                                                              Foreground="{DynamicResource TextPrimary}" Margin="0,0,3,0" FontSize="11"
                                                                              ToolTip="Invert this condition (match lines that do NOT contain the value)"/>
                                                                    <Button Grid.Column="4" Content="X" Style="{StaticResource DangerBtn}" Width="22" Padding="0,2" FontSize="11"
                                                                            Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" ToolTip="Remove this condition"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="+ Add Condition Group" Style="{StaticResource Btn}" Command="{Binding AddGroupCommand}" Margin="0,4,0,0"
                                        ToolTip="Add another group of conditions. Groups are combined with the operator above (AND/OR)."/>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- ─── SECTION 4: FILE DATE RANGE ─── -->
                    <Border Style="{StaticResource SectionCard}">
                        <Expander Foreground="{DynamicResource TextPrimary}">
                            <Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="4. File Date Range (optional)" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Style="{StaticResource SectionDesc}" Margin="0"
                                               Text="Skip files outside this date range. Uses filename timestamp or file modification date."/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Only scan files from:" Style="{StaticResource FieldLabel}"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="From date:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Width="65" FontSize="11"/>
                                    <DatePicker Grid.Column="1" SelectedDate="{Binding FileTimeFrom}"
                                                ToolTip="Start date — files before this date will be skipped"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="To date:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Width="65" FontSize="11"/>
                                    <DatePicker Grid.Column="1" SelectedDate="{Binding FileTimeTo}"
                                                ToolTip="End date — files after this date will be skipped"/>
                                </Grid>

                                <Separator Margin="0,10" Background="{DynamicResource BorderColor}"/>

                                <TextBlock Text="Only show results with timestamp:" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="Filter results by the log entry's own timestamp (inside the file)."
                                           Style="{StaticResource SectionDesc}"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="From:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Width="65" FontSize="11"/>
                                    <DatePicker Grid.Column="1" SelectedDate="{Binding ResultTimeFrom}"
                                                ToolTip="Only show log entries with timestamps after this date"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="To:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Width="65" FontSize="11"/>
                                    <DatePicker Grid.Column="1" SelectedDate="{Binding ResultTimeTo}"
                                                ToolTip="Only show log entries with timestamps before this date"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- ─── SECTION 5: SEARCH ACTIONS ─── -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="5. Run Search" Style="{StaticResource SectionHeader}"/>

                            <Button Content="SEARCH" Style="{StaticResource PrimaryBtn}" Command="{Binding SearchCommand}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                    ToolTip="Start searching all selected locations with the configured query and conditions"/>
                            <Button Content="Cancel Search" Style="{StaticResource Btn}" Command="{Binding CancelSearchCommand}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,4"
                                    Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- Progress -->
                            <ProgressBar Height="6" Maximum="{Binding ProgressTotal}" Value="{Binding ProgressCurrent}" Margin="0,0,0,4"
                                         Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         Foreground="{DynamicResource PrimaryColor}" Background="{DynamicResource BgCard}"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <Separator Margin="0,4" Background="{DynamicResource BorderColor}"/>

                            <!-- Save / Load profile -->
                            <TextBlock Text="Search Profiles" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,4"/>
                            <TextBlock Text="Save your current search settings to reuse later, or load a previously saved profile."
                                       Style="{StaticResource SectionDesc}"/>
                            <WrapPanel>
                                <Button Content="Save Profile" Style="{StaticResource Btn}" Command="{Binding SaveConfigCommand}"
                                        ToolTip="Save current locations, query, and conditions as a reusable profile"/>
                                <Button Content="Load Profile" Style="{StaticResource Btn}" Command="{Binding LoadConfigCommand}"
                                        ToolTip="Load a previously saved search profile from a JSON file"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- ─── SECTION 6: SCHEDULING ─── -->
                    <Border Style="{StaticResource SectionCard}">
                        <Expander Foreground="{DynamicResource TextPrimary}">
                            <Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="6. Scheduled Searches (optional)" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Style="{StaticResource SectionDesc}" Margin="0"
                                               Text="Create self-contained scheduled searches with their own criteria, locations, and timing. Click '+ Add' to configure everything in one dialog."/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <DataGrid ItemsSource="{Binding Schedules}" SelectedItem="{Binding SelectedSchedule}"
                                          AutoGenerateColumns="False" IsReadOnly="True" Background="{DynamicResource BgCard}"
                                          MaxHeight="150" FontSize="11" RowHeight="24"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderColor}">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="35"/>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="80"/>
                                        <DataGridTextColumn Header="Search" Binding="{Binding SearchSummary}" Width="*"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding ScheduleType}" Width="55"/>
                                        <DataGridTextColumn Header="Time" Binding="{Binding RunTime, StringFormat=hh\\:mm}" Width="45"/>
                                        <DataGridTextColumn Header="Last Run" Binding="{Binding LastRunStatus}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="+ Add" Style="{StaticResource Btn}" Command="{Binding AddScheduleCommand}" FontSize="11" Padding="6,3"
                                            ToolTip="Create a new scheduled search with its own search criteria, locations, and timing"/>
                                    <Button Content="Edit" Style="{StaticResource Btn}" Command="{Binding EditScheduleCommand}" FontSize="11" Padding="6,3"/>
                                    <Button Content="▶ Start" Style="{StaticResource Btn}" Command="{Binding RunScheduleNowCommand}" FontSize="11" Padding="6,3"
                                            ToolTip="Close window, wait for the scheduled time, run the search in background, then reopen with the report"/>
                                    <Button Content="Remove" Style="{StaticResource DangerBtn}" Command="{Binding RemoveScheduleCommand}" FontSize="11" Padding="6,3"/>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ================================================================ -->
        <!-- RIGHT PANEL: Results                                              -->
        <!-- ================================================================ -->
        <DockPanel Grid.Column="2">

            <!-- Results header -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Search Results" FontFamily="{DynamicResource UIFontFamily}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Foreground="{DynamicResource PrimaryColor}" FontSize="16" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:N0} found">
                                <Binding Path="ResultCount"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding SearchDuration}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Clear Results" Style="{StaticResource Btn}" Command="{Binding ClearResultsCommand}"/>
            </Grid>

            <!-- Results footer -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgPanel}" CornerRadius="0,0,8,8" Padding="10,8" Margin="0,6,0,0"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                <WrapPanel>
                    <Button x:Name="JumpButton" Content="Jump to Log" Style="{StaticResource Btn}" Click="JumpToLog_Click"
                            ToolTip="Navigate to the selected log entry in the main window"/>
                    <Button x:Name="OpenAllFilesButton" Content="Open All Files" Style="{StaticResource Btn}" Click="OpenAllFiles_Click"
                            ToolTip="Open all files that contain search results"/>
                    <Button Content="First Occurrence" Style="{StaticResource Btn}" Command="{Binding FindFirstOccurrenceCommand}"
                            ToolTip="Jump to the earliest matching log entry by timestamp"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2"/>
                    <Button Content="Export CSV" Style="{StaticResource Btn}" Command="{Binding ExportCsvCommand}"
                            ToolTip="Export all results to a CSV spreadsheet file"/>
                    <Button Content="Export JSON" Style="{StaticResource Btn}" Command="{Binding ExportJsonCommand}"
                            ToolTip="Export all results to a JSON file"/>
                    <Button Content="Export Report" Style="{StaticResource PrimaryBtn}" Command="{Binding ExportReportCommand}"
                            ToolTip="Generate an HTML report with search parameters, summary statistics, and all results" Padding="10,5"/>
                </WrapPanel>
            </Border>

            <!-- Results DataGrid -->
            <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}"
                      RowStyle="{DynamicResource LogRowStyle}"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderColor}"
                      FontFamily="{DynamicResource ContentFontFamily}" FontSize="12"
                      MouseDoubleClick="ResultsGrid_MouseDoubleClick"
                      BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Location" Binding="{Binding LocationName}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryHover}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="4,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Lvl" Binding="{Binding ReferencedLogEntry.Level}" Width="50" FontWeight="Bold">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Type" Binding="{Binding LogType}" Width="42">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryColor}"/>
                                <Setter Property="Padding" Value="4,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Timestamp" Binding="{Binding ReferencedLogEntry.Date, StringFormat='yyyy-MM-dd HH:mm:ss.ffffff'}" Width="185">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Thread" Binding="{Binding ReferencedLogEntry.ThreadName}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Logger" Binding="{Binding ReferencedLogEntry.Logger}" Width="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Method" Binding="{Binding ReferencedLogEntry.Method}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryColor}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Message" Width="500">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ReferencedLogEntry.Message}" TextTrimming="CharacterEllipsis"
                                           FontFamily="{DynamicResource ContentFontFamily}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimary}" TextWrapping="NoWrap"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Matched In" Binding="{Binding MatchedField}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{DynamicResource WarningColor}"/>
                                <Setter Property="FontSize" Value="11"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="File" Width="250">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SessionName}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Cursor="Hand"
                                           Foreground="{DynamicResource PrimaryColor}"
                                           TextDecorations="Underline"
                                           ToolTip="{Binding FilePath}"
                                           MouseLeftButtonDown="FileLink_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Window>
