<UserControl x:Class="IndiLogs_3._0.Controls.StepRecorderTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:IndiLogs_3._0.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1200">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvertedBoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisNet"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Toolbar -->
            <RowDefinition Height="*"/>      <!-- Image area -->
            <RowDefinition Height="Auto"/>   <!-- Status bar -->
            <RowDefinition Height="150"/>    <!-- Text content panel -->
        </Grid.RowDefinitions>

        <!-- ═══ Row 0: Toolbar ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="10,6">
            <DockPanel>
                <!-- Navigation + playback buttons -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <Button Command="{Binding PreviousCommand}"
                            Style="{DynamicResource ModernBtn}"
                            Width="72" Height="28" Padding="4,0"
                            ToolTip="Previous frame">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◀" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="PREV" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NextCommand}"
                            Style="{DynamicResource ModernBtn}"
                            Width="72" Height="28" Padding="4,0" Margin="4,0,0,0"
                            ToolTip="Next frame">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="NEXT" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="▶" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{DynamicResource BorderColor}" Margin="8,4"/>

                    <Button Command="{Binding PlayCommand}"
                            Style="{DynamicResource PrimaryBtn}"
                            Width="72" Height="28" Padding="4,0"
                            ToolTip="Play automatically (1 frame/sec)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="PLAY" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding StopCommand}"
                            Style="{DynamicResource ModernBtn}"
                            Width="72" Height="28" Padding="4,0" Margin="4,0,0,0"
                            ToolTip="Stop playback">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="■" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DangerColor}"/>
                            <TextBlock Text="STOP" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{DynamicResource BorderColor}" Margin="8,4"/>

                    <!-- Loading indicator -->
                    <TextBlock Text="⏳ Loading…"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource WarningColor}"
                               Margin="0,0,8,0"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                    <!-- Playing indicator -->
                    <Border Background="{DynamicResource PrimaryColor}" CornerRadius="4"
                            Padding="6,2" Margin="0,0,8,0"
                            Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="▶ PLAYING" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>

                <!-- Right-side actions -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding ScreenshotCommand}"
                            Style="{DynamicResource ModernBtn}"
                            Width="110" Height="28" Padding="4,0"
                            ToolTip="Copy current image to clipboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📷" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="SCREENSHOT" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenFolderCommand}"
                            Style="{DynamicResource ModernBtn}"
                            Width="90" Height="28" Padding="4,0" Margin="4,0,0,0"
                            ToolTip="Extract current image to temp folder and open in Explorer">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="OPEN" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Row 1: Image display ═══ -->
        <Grid Grid.Row="1" Background="{DynamicResource BgDark}">

            <!-- Empty state — shown when no frames loaded -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasFrames, Converter={StaticResource InvertedBoolToVis}}">
                <TextBlock Text="🎞" FontSize="56" HorizontalAlignment="Center"
                           Margin="0,0,0,12" Opacity="0.3"/>
                <TextBlock Text="No step recordings found."
                           FontSize="14" Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Load a binary APP ZIP that contains IndigoLogs\ISR\Steps\ images."
                           FontSize="11" Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.7"/>
            </StackPanel>

            <!-- Image viewer — fits the whole image inside the available space, no scrollbar -->
            <Image Source="{Binding CurrentFrame.Bitmap}"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="6"
                   Visibility="{Binding HasFrames, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- ═══ Row 2: Status bar ═══ -->
        <Border Grid.Row="2" Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,1"
                Padding="12,4">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"
                       FontFamily="{DynamicResource ContentFontFamily}"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- ═══ Row 3: Text content ═══ -->
        <Grid Grid.Row="3" Background="{DynamicResource BgPanel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="TEXT CONTENT"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="10" FontWeight="Bold"
                       Margin="12,6,0,4" Opacity="0.7"/>

            <TextBox Grid.Row="1"
                     Text="{Binding CurrentFrame.TextContent, FallbackValue=''}"
                     IsReadOnly="True"
                     FontFamily="{DynamicResource ContentFontFamily}"
                     FontSize="11"
                     Foreground="{DynamicResource TextPrimary}"
                     Background="Transparent"
                     BorderThickness="0"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Padding="12,0,12,8"/>
        </Grid>
    </Grid>
</UserControl>
