<UserControl x:Class="IndiLogs_3._0.Controls.AppLogsTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:IndiLogs_3._0.Controls"
             xmlns:converters="clr-namespace:IndiLogs_3._0.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <DataGrid x:Name="AppLogsGrid" Margin="0,0,12,0" ItemsSource="{Binding FilterVM.AppDevLogsFiltered}" SelectedItem="{Binding SelectedLog}" Sorting="AppLogsGrid_Sorting" FontSize="{Binding GridFontSize}" FontFamily="{DynamicResource ContentFontFamily}" FontWeight="{DynamicResource ContentFontWeight}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="App Logs Grid"
                  PreviewMouseRightButtonDown="AppLogsGrid_PreviewMouseRightButtonDown"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  HorizontalScrollBarVisibility="Auto" RequestBringIntoView="AppLogsGrid_RequestBringIntoView" Loaded="AppLogsGrid_Loaded" LoadingRow="AppLogsGrid_LoadingRow"
                  GridLinesVisibility="Vertical" VerticalGridLinesBrush="{DynamicResource BorderColor}" SelectionChanged="AppLogsGrid_SelectionChanged" ColumnReordered="AppLogsGrid_ColumnReordered">

            <DataGrid.InputBindings>
                <KeyBinding Key="Space" Command="{Binding MarkRowCommand}" />
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding ViewLogDetailsCommand}" CommandParameter="{Binding SelectedLog}" />
            </DataGrid.InputBindings>

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding PlacementTarget.DataContext.FilterContextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Time Focus Filter"/>
                    <Separator/>
                    <MenuItem Header="✏️ Add/Edit Annotation" Command="{Binding AddAnnotationCommand}" CommandParameter="{Binding SelectedLog}"/>
                    <MenuItem Header="🗑 Delete Annotation" Command="{Binding DeleteAnnotationCommand}" CommandParameter="{Binding SelectedLog}"/>
                    <Separator/>
                    <MenuItem Header="Filter Out (Message)..." Command="{Binding FilterOutCommand}"/>
                    <Separator/>
                    <MenuItem Header="📌 Start Range" Command="{Binding StartRangeCommand}"/>
                    <MenuItem Header="📌 End Range" Command="{Binding EndRangeCommand}"/>
                    <MenuItem Header="❌ Clear Range" Command="{Binding ClearRangeCommand}"/>
                    <Separator/>
                    <MenuItem Header="📊 Create Chart from Pattern..." Command="{Binding CreateChartFromPatternCommand}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="30" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding AnnotationIcon}" Command="{Binding DataContext.ToggleAnnotationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="14" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Click to show/hide annotation" Visibility="{Binding HasAnnotation, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Lvl" Width="50" CanUserSort="True" SortMemberPath="Level">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:SelectableTextBlock Text="{Binding Level, Mode=OneWay}" FontWeight="Bold">
                                <controls:SelectableTextBlock.Style>
                                    <Style TargetType="controls:SelectableTextBlock" BasedOn="{StaticResource SelectableTextBlockStyle}">
                                        <Setter Property="Padding" Value="8,0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsErrorOrEvents}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource RowErrorFg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="DEBUG">
                                                <Setter Property="Foreground" Value="#4FC3F7"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RowForeground}" Value="{x:Static Brushes.Black}">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasAnnotation}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrentMarked}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:SelectableTextBlock.Style>
                            </controls:SelectableTextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Timestamp" Width="180" CanUserSort="True" SortMemberPath="Time">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:SelectableTextBlock Text="{Binding Date, Mode=OneWay, StringFormat='yyyy-MM-dd HH:mm:ss.ffffff'}">
                                <controls:SelectableTextBlock.Style>
                                    <Style TargetType="controls:SelectableTextBlock" BasedOn="{StaticResource SelectableTextBlockStyle}">
                                        <Setter Property="Padding" Value="8,0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsErrorOrEvents}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource RowErrorFg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RowForeground}" Value="{x:Static Brushes.Black}">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasAnnotation}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrentMarked}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:SelectableTextBlock.Style>
                            </controls:SelectableTextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="200" CanUserSort="True" SortMemberPath="Logger">
                    <DataGridTemplateColumn.Header>
                        <Button Content="🔍 Logger" Click="LoggerFilterButton_Click" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" Cursor="Hand" ToolTip="Click to filter by logger" FontSize="12" Padding="6,2" AutomationProperties.Name="Filter by Logger"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:SelectableTextBlock Text="{Binding Logger, Mode=OneWay}">
                                <controls:SelectableTextBlock.Style>
                                    <Style TargetType="controls:SelectableTextBlock" BasedOn="{StaticResource SelectableTextBlockStyle}">
                                        <Setter Property="Padding" Value="8,0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsErrorOrEvents}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource RowErrorFg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RowForeground}" Value="{x:Static Brushes.Black}">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasAnnotation}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrentMarked}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:SelectableTextBlock.Style>
                            </controls:SelectableTextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="90" CanUserSort="True" SortMemberPath="Thread">
                    <DataGridTemplateColumn.Header>
                        <Button Content="🔍 Thread" Click="ThreadFilterButton_Click" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" Cursor="Hand" ToolTip="Click to filter by thread" FontSize="12" Padding="6,2" AutomationProperties.Name="Filter by Thread"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:SelectableTextBlock Text="{Binding ThreadName, Mode=OneWay}">
                                <controls:SelectableTextBlock.Style>
                                    <Style TargetType="controls:SelectableTextBlock" BasedOn="{StaticResource SelectableTextBlockStyle}">
                                        <Setter Property="Padding" Value="8,0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsErrorOrEvents}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource RowErrorFg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RowForeground}" Value="{x:Static Brushes.Black}">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasAnnotation}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrentMarked}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:SelectableTextBlock.Style>
                            </controls:SelectableTextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="230" CanUserSort="True" SortMemberPath="Method">
                    <DataGridTemplateColumn.Header>
                        <Button Content="🔍 Method" Click="MethodFilterButton_Click" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" Cursor="Hand" ToolTip="Click to filter by method" FontSize="12" Padding="6,2" AutomationProperties.Name="Filter by Method"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:SelectableTextBlock Text="{Binding Method, Mode=OneWay}">
                                <controls:SelectableTextBlock.Style>
                                    <Style TargetType="controls:SelectableTextBlock" BasedOn="{StaticResource SelectableTextBlockStyle}">
                                        <Setter Property="Padding" Value="8,0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsErrorOrEvents}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource RowErrorFg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RowForeground}" Value="{x:Static Brushes.Black}">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasAnnotation}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrentMarked}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:SelectableTextBlock.Style>
                            </controls:SelectableTextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Message" MinWidth="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:HighlightTextBlock Text="{Binding Message}" HighlightText="{Binding DataContext.FilterVM.SearchText, RelativeSource={RelativeSource AncestorType=DataGrid}}" VerticalAlignment="Center" Padding="8,0">
                                <controls:HighlightTextBlock.Style>
                                    <Style TargetType="controls:HighlightTextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="TextWrapping" Value="NoWrap"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsErrorOrEvents}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource RowErrorFg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RowForeground}" Value="{x:Static Brushes.Black}">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasAnnotation}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrentMarked}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:HighlightTextBlock.Style>
                            </controls:HighlightTextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Pattern" Width="150" SortMemberPath="Pattern" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:SelectableTextBlock Text="{Binding Pattern, Mode=OneWay}">
                                <controls:SelectableTextBlock.Style>
                                    <Style TargetType="controls:SelectableTextBlock" BasedOn="{StaticResource SelectableTextBlockStyle}">
                                        <Setter Property="Padding" Value="8,0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsErrorOrEvents}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource RowErrorFg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RowForeground}" Value="{x:Static Brushes.Black}">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasAnnotation}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrentMarked}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:SelectableTextBlock.Style>
                            </controls:SelectableTextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Data" Width="200" SortMemberPath="Data" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:SelectableTextBlock Text="{Binding Data, Mode=OneWay}">
                                <controls:SelectableTextBlock.Style>
                                    <Style TargetType="controls:SelectableTextBlock" BasedOn="{StaticResource SelectableTextBlockStyle}">
                                        <Setter Property="Padding" Value="8,0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsErrorOrEvents}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource RowErrorFg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RowForeground}" Value="{x:Static Brushes.Black}">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasAnnotation}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrentMarked}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:SelectableTextBlock.Style>
                            </controls:SelectableTextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Exception" Width="250" Visibility="Collapsed" SortMemberPath="Exception" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:SelectableTextBlock Text="{Binding Exception, Mode=OneWay}">
                                <controls:SelectableTextBlock.Style>
                                    <Style TargetType="controls:SelectableTextBlock" BasedOn="{StaticResource SelectableTextBlockStyle}">
                                        <Setter Property="Padding" Value="8,0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsErrorOrEvents}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource RowErrorFg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RowForeground}" Value="{x:Static Brushes.Black}">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasAnnotation}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrentMarked}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:SelectableTextBlock.Style>
                            </controls:SelectableTextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource BgDark}" BorderBrush="{DynamicResource WarningColor}" BorderThickness="2" Padding="12" Margin="5,0,5,5" CornerRadius="4">
                        <TextBlock Text="{Binding AnnotationContent}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontStyle="Italic"
                                   VerticalAlignment="Center"/>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource LogRowStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAnnotationExpanded}" Value="True">
                            <Setter Property="DetailsVisibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsAnnotationExpanded}" Value="False">
                            <Setter Property="DetailsVisibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- Log Heatmap Scrollbar - positioned on the right edge -->
        <controls:LogHeatmapControl x:Name="HeatmapControl"
                                    Width="10"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch"
                                    Margin="0,22,0,18"
                                    ItemsSource="{Binding FilterVM.AppDevLogsFiltered}"/>
    </Grid>
</UserControl>