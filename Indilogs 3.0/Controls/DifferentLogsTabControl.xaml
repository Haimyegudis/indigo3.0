<UserControl x:Class="IndiLogs_3._0.Controls.DifferentLogsTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:IndiLogs_3._0.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1200">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvertedBoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Top toolbar ── -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="10,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Browse button -->
                <Button Command="{Binding BrowseCommand}"
                        Style="{DynamicResource PrimaryBtn}"
                        Height="28" Padding="12,4"
                        ToolTip="Open a log file using the plugin system">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📂" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="OPEN LOG FILE" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- File path label -->
                <TextBlock Text="{Binding CurrentFileName}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimary}"
                           FontWeight="SemiBold"
                           Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}"/>

                <!-- Close file button -->
                <Button Command="{Binding CloseFileCommand}"
                        Style="{DynamicResource ModernBtn}"
                        Background="Transparent"
                        ToolTip="Close this file"
                        Width="22" Height="22" Padding="0" Margin="6,0,0,0"
                        Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="✕" FontSize="10" Foreground="{DynamicResource DangerColor}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- Separator -->
                <Rectangle Width="1" Fill="{DynamicResource BorderColor}" Margin="10,4" Height="20"
                           Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}"/>

                <!-- Status / entry count -->
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"
                           Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}"/>

                <!-- Loading indicator -->
                <TextBlock Text="⏳ Loading…"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource WarningColor}"
                           Margin="10,0,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- ── Empty state ── -->
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasFile, Converter={StaticResource InvertedBoolToVis}}">
            <TextBlock Text="📋"
                       FontSize="48"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"
                       Opacity="0.4"/>
            <TextBlock Text="Click 'OPEN LOG FILE' to browse and view any supported log format."
                       FontSize="14"
                       Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
            <TextBlock Text="All installed plugins are available for auto-detection."
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"
                       Opacity="0.7"/>
        </StackPanel>

        <!-- ── DataGrid (columns rebuilt in code-behind) ── -->
        <DataGrid x:Name="LogGrid"
                  Grid.Row="1"
                  ItemsSource="{Binding FilteredEntries}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  GridLinesVisibility="Vertical"
                  VerticalGridLinesBrush="{DynamicResource BorderColor}"
                  FontFamily="{DynamicResource ContentFontFamily}"
                  FontSize="{Binding DataContext.GridFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                  FontWeight="{DynamicResource ContentFontWeight}"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource LogRowStyle}">
                    <Style.Triggers>
                        <!-- Error level → red text -->
                        <DataTrigger Binding="{Binding IsErrorOrEvents}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource RowErrorFg}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </Grid>
</UserControl>
