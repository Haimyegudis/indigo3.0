                                             HasSystemDefaultColor==False: state-transition rows keep their Black text. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding GridType, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="FILTERED"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="False"/>
                                                <Condition Binding="{Binding IsErrorOrEvents}" Value="False"/>
                                                <Condition Binding="{Binding HasSystemDefaultColor}" Value="False"/>
                                                <Condition Binding="{Binding IsMarked}" Value="False"/>
                                                <Condition Binding="{Binding IsCurrentMarked}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:SelectableTextBlock.Style>
                        </controls:SelectableTextBlock>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Method" Width="200" Visibility="Collapsed" SortMemberPath="Method" CanUserSort="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <controls:SelectableTextBlock Text="{Binding Method, Mode=OneWay}">
                            <controls:SelectableTextBlock.Style>
                                <Style TargetType="controls:SelectableTextBlock" BasedOn="{StaticResource SelectableTextBlockStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsErrorOrEvents}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource RowErrorFg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RowForeground}" Value="{x:Static Brushes.Black}">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasAnnotation}" Value="True">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
