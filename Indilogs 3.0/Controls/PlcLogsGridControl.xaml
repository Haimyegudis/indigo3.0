                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Process" Width="120" Visibility="Collapsed" SortMemberPath="Process" CanUserSort="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <controls:SelectableTextBlock Text="{Binding Process, Mode=OneWay}">
                            <controls:SelectableTextBlock.Style>
                                <Style TargetType="controls:SelectableTextBlock" BasedOn="{StaticResource SelectableTextBlockStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsErrorOrEvents}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource RowErrorFg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RowForeground}" Value="{x:Static Brushes.Black}">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasAnnotation}" Value="True">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrentMarked}" Value="True">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <!-- PLC FILTERED: reset foreground, suppress custom colors/annotations.
                                             IsMarked/IsCurrentMarked==False: marked rows still show Black text.
                                             HasSystemDefaultColor==False: state-transition rows keep their Black text. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding GridType, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="FILTERED"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="False"/>
                                                <Condition Binding="{Binding IsErrorOrEvents}" Value="False"/>
                                                <Condition Binding="{Binding HasSystemDefaultColor}" Value="False"/>
                                                <Condition Binding="{Binding IsMarked}" Value="False"/>
                                                <Condition Binding="{Binding IsCurrentMarked}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:SelectableTextBlock.Style>
                        </controls:SelectableTextBlock>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Message" MinWidth="400">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <controls:HighlightTextBlock Text="{Binding Message}" HighlightText="{Binding DataContext.FilterVM.SearchText, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center">
                            <controls:HighlightTextBlock.Style>
                                <Style TargetType="controls:HighlightTextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsErrorOrEvents}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource RowErrorFg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RowForeground}" Value="{x:Static Brushes.Black}">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasAnnotation}" Value="True">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrentMarked}" Value="True">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <!-- PLC FILTERED: reset foreground, suppress custom colors/annotations.
                                             IsMarked/IsCurrentMarked==False: marked rows still show Black text.
                                             HasSystemDefaultColor==False: state-transition rows keep their Black text. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding GridType, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="FILTERED"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="False"/>
                                                <Condition Binding="{Binding IsErrorOrEvents}" Value="False"/>
                                                <Condition Binding="{Binding HasSystemDefaultColor}" Value="False"/>
                                                <Condition Binding="{Binding IsMarked}" Value="False"/>
                                                <Condition Binding="{Binding IsCurrentMarked}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:HighlightTextBlock.Style>
                        </controls:HighlightTextBlock>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>

        <!-- Row Details Template for Annotations -->
        <DataGrid.RowDetailsTemplate>
            <DataTemplate>
                <Border Background="{DynamicResource BgDark}" BorderBrush="{DynamicResource WarningColor}" BorderThickness="2" Padding="12" Margin="5,0,5,5" CornerRadius="4">
                    <!-- Annotation Text -->
                    <TextBlock Text="{Binding AnnotationContent}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimary}"
                               FontStyle="Italic"
                               VerticalAlignment="Center"/>
                </Border>
            </DataTemplate>
        </DataGrid.RowDetailsTemplate>

        <!-- Row Style with Details Visibility -->
        <DataGrid.RowStyle>
            <Style TargetType="DataGridRow" BasedOn="{StaticResource LogRowStyle}">
                <Style.Triggers>
                    <!-- PLC FILTERED: suppress user-set custom colors; show factory-default colour and marks.
                         IsMarked/IsCurrentMarked==False so marked rows still get their highlight in FILTERED
                         (marking is shared between PLC and FILTERED since they are the same LogEntry objects). -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding GridType, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="FILTERED"/>
                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="False"/>
                            <Condition Binding="{Binding IsMarked}" Value="False"/>
                            <Condition Binding="{Binding IsCurrentMarked}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{Binding FilteredRowBackground}"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </DataGrid.RowStyle>
    </DataGrid>

        <!-- Log Heatmap Scrollbar - positioned on the right edge -->
        <controls:LogHeatmapControl x:Name="HeatmapControl"
                                    Width="10"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch"
                                    Margin="0,22,0,18"
                                    ItemsSource="{Binding LogsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    </Grid>
</UserControl>
