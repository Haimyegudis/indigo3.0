                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrentMarked}" Value="True">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <!-- PLC FILTERED: reset foreground, suppress custom colors/annotations.
                                             IsMarked/IsCurrentMarked==False: marked rows still show Black text.
                                             HasSystemDefaultColor==False: state-transition rows keep their Black text. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding GridType, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="FILTERED"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="False"/>
                                                <Condition Binding="{Binding IsErrorOrEvents}" Value="False"/>
                                                <Condition Binding="{Binding HasSystemDefaultColor}" Value="False"/>
                                                <Condition Binding="{Binding IsMarked}" Value="False"/>
                                                <Condition Binding="{Binding IsCurrentMarked}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:SelectableTextBlock.Style>
                        </controls:SelectableTextBlock>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Width="130" SortMemberPath="ThreadName" CanUserSort="True">
                <DataGridTemplateColumn.Header>
                    <Button Content="🔍 Thread"
                            Click="ThreadFilterButton_Click"
                            Cursor="Hand"
                            ToolTip="Click to filter by thread"
                            FontSize="12"
                            Padding="6,2"
                            AutomationProperties.Name="Filter by Thread">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryColor}"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <controls:SelectableTextBlock Text="{Binding ThreadName, Mode=OneWay}">
                            <controls:SelectableTextBlock.Style>
                                <Style TargetType="controls:SelectableTextBlock" BasedOn="{StaticResource SelectableTextBlockStyle}">
                                    <Setter Property="Padding" Value="25,0"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsErrorOrEvents}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource RowErrorFg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RowForeground}" Value="{x:Static Brushes.Black}">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasAnnotation}" Value="True">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrentMarked}" Value="True">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <!-- PLC FILTERED: reset to PrimaryColor, suppress custom colors/annotations.
                                             IsMarked/IsCurrentMarked==False: marked rows still show Black text. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding GridType, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="FILTERED"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="False"/>
                                                <Condition Binding="{Binding IsErrorOrEvents}" Value="False"/>
                                                <Condition Binding="{Binding HasSystemDefaultColor}" Value="False"/>
                                                <Condition Binding="{Binding IsMarked}" Value="False"/>
                                                <Condition Binding="{Binding IsCurrentMarked}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:SelectableTextBlock.Style>
                        </controls:SelectableTextBlock>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Logger" Width="250" Visibility="Collapsed" SortMemberPath="Logger" CanUserSort="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <controls:SelectableTextBlock Text="{Binding Logger, Mode=OneWay}">
                            <controls:SelectableTextBlock.Style>
                                <Style TargetType="controls:SelectableTextBlock" BasedOn="{StaticResource SelectableTextBlockStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsErrorOrEvents}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource RowErrorFg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RowForeground}" Value="{x:Static Brushes.Black}">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasAnnotation}" Value="True">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMarked}" Value="True">
