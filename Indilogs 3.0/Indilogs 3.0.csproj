<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>IndiLogs_3._0</RootNamespace>
    <AssemblyName>IndiLogs 3.0</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>Resources\indilogs.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>

    <!-- Assembly metadata (was in AssemblyInfo.cs) -->
    <AssemblyTitle>IndiLogs 3.0</AssemblyTitle>
    <Product>IndiLogs 3.0</Product>
    <Copyright>Copyright © 2025</Copyright>
    <AssemblyVersion>1.0.0.10</AssemblyVersion>
    <FileVersion>1.0.0.10</FileVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <!-- Single-file self-contained deployment (use: dotnet publish -r win-x64) -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- NuGet package references -->
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="CsvHelper.Excel.Core" Version="27.2.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="3.119.0" />
    <PackageReference Include="HarfBuzzSharp" Version="8.3.1.1" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Exclude OpenTK transitive dependency (not needed, not compatible with .NET 10) -->
  <ItemGroup>
    <PackageReference Include="OpenTK" Version="3.3.1" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="OpenTK.GLWpfControl" Version="3.3.0" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <!-- Indigo.Infra DLLs (legacy .NET Framework 4.7.1 — loaded via compatibility shim) -->
  <ItemGroup>
    <Reference Include="Indigo.Infra.ICL">
      <HintPath>Libs\Indigo.Infra.ICL.dll</HintPath>
    </Reference>
    <Reference Include="Indigo.Infra.ICL.Core">
      <HintPath>Libs\Indigo.Infra.ICL.Core.dll</HintPath>
    </Reference>
    <Reference Include="Indigo.Infra.Logging">
      <HintPath>Libs\Indigo.Infra.Logging.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Expose internal members to the test project -->
  <ItemGroup>
    <InternalsVisibleTo Include="IndiLogs.Tests" />
  </ItemGroup>

  <!-- Plugin API contract library -->
  <ItemGroup>
    <ProjectReference Include="..\IndiLogs.PluginAPI\IndiLogs.PluginAPI.csproj" />
  </ItemGroup>

  <!-- Icon resources -->
  <ItemGroup>
    <Resource Include="Resources\jira.ico" />
    <Resource Include="Resources\outlook.ico" />
    <Resource Include="Resources\kibana.ico" />
    <Resource Include="Resources\mark.ico" />
  </ItemGroup>

  <!-- appsettings.json — excluded from single-file so users can edit update paths -->
  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
